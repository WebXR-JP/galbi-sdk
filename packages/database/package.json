{
	"name": "@repo/database",
	"version": "0.0.1",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"private": true,
	"scripts": {
		"dev": "wrangler dev --port 3002",
		"db:generate": "prisma generate",
		"db:migrate:from-schema": "node scripts/generate-wrangler-migration.cjs",
		"db:migrate:local": "wrangler d1 migrations apply galbi-database --local",
		"db:migrate:remote": "wrangler d1 migrations apply galbi-database --remote",
		"deploy": "wrangler deploy --minify",
		"check": "biome check --config-path ../../packages/config/biome/database.json --write .",
		"lint": "biome lint --config-path ../../packages/config/biome/database.json --write .",
		"format": "biome format --config-path ../../packages/config/biome/database.json --write ."
	},
	"dependencies": {
		"@prisma/adapter-d1": "^7.5.0",
		"@prisma/client": "^7.5.0"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:biome",
		"@cloudflare/workers-types": "catalog:",
		"@repo/config": "workspace:*",
		"prisma": "^7.5.0",
		"wrangler": "catalog:"
	}
}
